# Velan Foods - Environment Variables
# இந்த file-ஐ .env என்று rename செய்யவும்

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/velanfoods
# Cloud-ல் பயன்படுத்த: mongodb+srv://username:password@cluster.mongodb.net/velanfoods

# JWT Secret (மாற்றவும்)
JWT_SECRET=velanfoods_super_secret_key_2025
JWT_EXPIRE=30d

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000
